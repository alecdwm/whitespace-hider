{
  "manifest_version": 3,
  "name": "Whitespace Hider for GitHub",
  "version": "1.0.0",
  "description": "Turns on \"Hide whitespace\" by default on GitHub pull request diffs.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  }
}
